# =============================================================================
# Split config by machine. Never commit real .env files.
# =============================================================================

# -----------------------------------------------------------------------------
# REMOTE PAIRING SERVER only  (python -m webapp)
# Job: show QR to the Lovense device owner; complete Connect scan.
# -----------------------------------------------------------------------------
# Developer token from https://www.lovense.com/user/developer/info
LOVENSE_TOKEN=

# Website name on the Lovense developer dashboard
LOVENSE_PLATFORM=Rys Circus

# Shared secret so remote controllers can read uid/platform (not the token)
CONTROLLER_API_KEY=change-me-to-a-long-random-string

# Bind loopback when nginx (or another reverse proxy) terminates TLS:
# WEB_HOST=127.0.0.1
# WEB_PORT=8080
# See deploy/nginx/pairing-server.conf
# LOVENSE_UNAME=BuzzLightyear

# Caddy + Docker (deploy/caddy/compose.yml) — public hostname for auto HTTPS:
# PAIRING_DOMAIN=pair.example.com
# Pair state path inside the container (default already set in the image):
# PAIRING_STATE_PATH=/data/pairing_state.json

# LOVENSE_UID is written automatically after a successful web pair.


# -----------------------------------------------------------------------------
# CONTROLLER MACHINE only  (python voice_trigger.py, future motion, …)
# Job: triggers → Lovense Socket commands. Different PC from the pairing server.
# -----------------------------------------------------------------------------
# Same developer token as the dashboard (configure locally; never fetched)
LOVENSE_TOKEN=

# Where the pairing helper is hosted (owner already paired there)
PAIRING_SERVER_URL=https://pair.example.com

# Same value as CONTROLLER_API_KEY on the pairing server
CONTROLLER_API_KEY=change-me-to-a-long-random-string

# Optional overrides if you refuse to fetch from the pairing server:
# LOVENSE_UID=
# LOVENSE_PLATFORM=Rys Circus
# LOVENSE_UNAME=BuzzLightyear

# GUI: python controller_gui.py
# CLI voice: python voice_trigger.py --model ./vosk-model-small-en-us-0.15
# VOSK_MODEL=./vosk-model-small-en-us-0.15
# TRIGGERS_FILE=./triggers.json
# LOVENSE_ACTION=Vibrate:16
# LOVENSE_TIME_SEC=5
